NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Create a dedicated MySQL 8 database and user before running db:migrate.
DATABASE_URL=mysql://trust_tally:change-me@127.0.0.1:3306/trust_tally
# Set to true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false
TRUST_PROXY=false
# Authentication uses registered phone numbers and six-digit PINs. No SMS provider is required.
BUSINESS_TIMEZONE=Asia/Karachi

# Optional: use a separate disposable database to run MySQL integration tests.
TEST_DATABASE_URL=
